# Load personal PATH and functions
[[ -f "$HOME/.config/zsh/path.zsh" ]] && source "$HOME/.config/zsh/path.zsh"
[[ -f "$HOME/.config/zsh/function.zsh" ]] && source "$HOME/.config/zsh/function.zsh"

# Load plain-text env vars (one per line: KEY=VALUE)
_env_file="$HOME/.config/zsh/env"
if [[ -f "$_env_file" ]]; then
	while IFS= read -r line || [[ -n "$line" ]]; do
		[[ -z "$line" || "$line" == \#* ]] && continue
		_key="${line%%=*}"
		_val="${line#*=}"
		[[ -z "$_key" || "$_key" == "$line" ]] && continue
		export "$_key"="$_val"
	done < "$_env_file"
fi
unset _env_file

#brew (before compinit so its completion dir is on fpath)
eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv zsh)"

# De-duplicate PATH/fpath (nested shells would otherwise keep growing them)
typeset -U path fpath FPATH

# History
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=10000
setopt hist_ignore_dups hist_ignore_space hist_verify share_history append_history

# Completion function directories
fpath=(~/.config/zsh/completions $fpath)
[[ -d ~/.local/share/sheldon/repos/github.com/zsh-users/zsh-completions/src ]] &&
  fpath+=(~/.local/share/sheldon/repos/github.com/zsh-users/zsh-completions/src)

# Completion system (must run before compdef, fzf-tab, zoxide, atuin)
autoload -Uz compinit && compinit

# Completions for personal functions
compdef _directories md

# Environment
export GPG_TTY=$TTY

# Autoload functions
autoload -Uz zmv

# Shell options: http://zsh.sourceforge.net/Doc/Release/Options.html.
setopt glob_dots     # no special treatment for file names with a leading dot
setopt no_auto_menu  # require an extra TAB press to open the completion menu

#rgrc
eval "$(rgrc --aliases)"

# Convert rgrc aliases to wrapper functions: functions are not expanded for
# completion lookup, so systemctl/podman/... keep their own completions
# (an alias would route completion to _comps[rgrc], which doesn't exist)
for _rgrc_cmd in ${(k)aliases}; do
  [[ $aliases[$_rgrc_cmd] == "rgrc "* ]] || continue
  functions[$_rgrc_cmd]="${aliases[$_rgrc_cmd]} \"\$@\""
  unalias $_rgrc_cmd
done
unset _rgrc_cmd

# Load plain-text aliases (must come after rgrc so rgrc aliases win)
_alias_file="$HOME/.config/zsh/alias"
if [[ -f "$_alias_file" ]]; then
	while IFS= read -r line || [[ -n "$line" ]]; do
		[[ -z "$line" || "$line" == \#* ]] && continue
		_name="${line%%=*}"
		_cmd="${line#*=}"
		[[ -z "$_name" || -z "$_cmd" || "$_name" == "$line" ]] && continue
		alias "$_name"="$_cmd"
	done < "$_alias_file"
fi
unset _alias_file

#zoxide
eval "$(zoxide init zsh)"

#atuin
. "$HOME/.atuin/bin/env"
#eval "$(atuin pty-proxy init zsh)"
eval "$(atuin init zsh)"

# Use emacs keymap (must precede plugin loading so plugin key binds land in
# the right keymap; otherwise main defaults to viins because EDITOR is vim-like)
bindkey -e

#sheldon
eval "$(sheldon source)"

# Key bindings
bindkey '^Z' undo
bindkey '\e/' redo
bindkey '^H' backward-kill-word                    # Ctrl+Backspace
bindkey '^[[3;5~' kill-word                        # Ctrl+Delete
bindkey '^[[1;5D' backward-word                    # Ctrl+Left
bindkey '^[[1;5C' forward-word                     # Ctrl+Right

# Ctrl+V pastes clipboard via widget (terminal passes ^V through to zsh)
paste-clipboard() {
  local clip
  clip=$(wl-paste --no-newline 2>/dev/null) || clip=$(xclip -o -selection clipboard 2>/dev/null) || return 1
  LBUFFER+=$clip
}
zle -N paste-clipboard
bindkey '^V' paste-clipboard

# Shift+Enter inserts a newline (Ghostty sends \n, i.e. ^J)
insert-newline() { LBUFFER+=$'\n' }
zle -N insert-newline
bindkey '^J' insert-newline

# Ctrl+Shift+Z → redo (Ghostty sends it as CSI u)
bindkey '\e[122;6u' redo

autoload -Uz history-search-end

zle -N history-beginning-search-backward-end history-search-end
zle -N history-beginning-search-forward-end history-search-end

bindkey -M emacs '^[[A' history-beginning-search-backward-end
bindkey -M emacs '^[[B' history-beginning-search-forward-end
bindkey -M emacs '^P' history-beginning-search-backward-end
bindkey -M emacs '^N' history-beginning-search-forward-end

# Directory navigation
setopt auto_pushd
setopt pushd_ignore_dups
DIRSTACKSIZE=20

alt-cd-up() {
  cd .. || return
  zle reset-prompt
}
zle -N alt-cd-up
bindkey -M emacs '\eh' alt-cd-up

alt-pushd-next() {
  pushd +1 > /dev/null || return
  zle reset-prompt
}
zle -N alt-pushd-next
bindkey -M emacs '\ej' alt-pushd-next

alt-pushd-prev() {
  pushd -1 > /dev/null || return
  zle reset-prompt
}
zle -N alt-pushd-prev
bindkey -M emacs '\ek' alt-pushd-prev

alt-zoxide-query() {
  zi || return
  zle reset-prompt
}
zle -N alt-zoxide-query
bindkey -M emacs '\el' alt-zoxide-query
