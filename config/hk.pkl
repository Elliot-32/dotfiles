amends "package://github.com/jdx/hk/releases/download/v1.57.0/hk@1.57.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v1.57.0/hk@1.57.0#/Builtins.pkl"

local checks = new Mapping<String, Step> {
  ["shellcheck"] = (Builtins.shellcheck) {
    check = "shellcheck -x {{files}}"
  }
  ["sh-syntax"] {
    glob = List("scripts/*.sh")
    check = "sh -n {{files}}"
  }
  ["powershell-syntax"] {
    glob = List("scripts/*.ps1")
    check = """
      set -e

      if command -v pwsh >/dev/null 2>&1; then
        ps_cmd=pwsh
        scripts_dir="$PWD/scripts"
      elif command -v powershell.exe >/dev/null 2>&1 && command -v wslpath >/dev/null 2>&1; then
        ps_cmd=powershell.exe
        scripts_dir="$(wslpath -w "$PWD/scripts")"
      else
        echo 'warning: PowerShell unavailable; skipping PowerShell syntax validation' >&2
        exit 0
      fi

      "$ps_cmd" -NoLogo -NoProfile -NonInteractive -Command '& {
        param([string] $ScriptsDir)
        $failed = $false

        Get-ChildItem -LiteralPath $ScriptsDir -Filter "*.ps1" | ForEach-Object {
          $tokens = $null
          $errors = $null
          [System.Management.Automation.Language.Parser]::ParseFile(
            $_.FullName,
            [ref] $tokens,
            [ref] $errors
          ) | Out-Null

          if ($errors.Count -gt 0) {
            $failed = $true
            $errors | ForEach-Object { Write-Error "$($_.Extent.File): $_" }
          }
        }

        if ($failed) { exit 1 }
      }' "$scripts_dir"
    """
  }
  ["mise-tool-disables"] {
    glob = List("conf.d/packages.pacman.toml", "conf.d/platform.omarchy.toml")
    check = """
      set -e
      test "$(MISE_ENV=arch,pacman mise settings get disable_tools)" = '["github:ryanoasis/nerd-fonts"]'
      test "$(MISE_ENV=arch,pacman,omarchy mise settings get disable_tools)" = '["github:ryanoasis/nerd-fonts", "github:tinted-theming/tinty"]'
    """
  }
  ["omarchy-hook"] {
    glob = List("../home/.config/omarchy/hooks/theme-set.d/50-themed-links")
    check = "bash -n {{files}} && shellcheck -x {{files}}"
  }
  ["zsh-syntax"] {
    glob = List(
      "../home/.zshrc",
      "../home/.p10k.zsh",
      "../home/.config/sheldon/plugins/*.zsh",
      "tests/*.zsh"
    )
    check = "zsh -n {{files}}"
  }
  ["terminal-notify"] {
    glob = List(
      "../home/.config/sheldon/plugins/terminal-notify.plugin.zsh",
      "tests/terminal-notify.zsh"
    )
    check = "zsh tests/terminal-notify.zsh"
  }
}

hooks {
  ["pre-commit"] {
    steps = checks
  }
  ["check"] {
    steps = checks
  }
}
