amends "package://github.com/jdx/hk/releases/download/v1.57.0/hk@1.57.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v1.57.0/hk@1.57.0#/Builtins.pkl"

local checks = new Mapping<String, Step> {
  ["shellcheck"] = (Builtins.shellcheck) {
    check = "shellcheck -x {{files}}"
  }
  ["sh-syntax"] {
    glob = List("scripts/*.sh")
    check = "sh -n {{files}}"
  }
  ["mise-tool-disables"] {
    glob = List("conf.d/packages.pacman.toml", "conf.d/platform.omarchy.toml")
    check = """
      set -e
      test "$(MISE_ENV=arch,pacman mise settings get disable_tools)" = '["github:ryanoasis/nerd-fonts"]'
      test "$(MISE_ENV=arch,pacman,omarchy mise settings get disable_tools)" = '["github:ryanoasis/nerd-fonts", "github:tinted-theming/tinty"]'
    """
  }
  ["omarchy-hook"] {
    glob = List("../home/.config/omarchy/hooks/theme-set.d/50-themed-links")
    check = "bash -n {{files}} && shellcheck -x {{files}}"
  }
  ["zsh-syntax"] {
    glob = List(
      "../home/.zshrc",
      "../home/.p10k.zsh",
      "../home/.config/sheldon/plugins/*.zsh",
      "tests/*.zsh"
    )
    check = "zsh -n {{files}}"
  }
  ["wsl-notify"] {
    glob = List(
      "../home/.config/sheldon/plugins/wsl-notify.plugin.zsh",
      "scripts/wsl-notify.ps1",
      "tests/wsl-notify.zsh"
    )
    check = "zsh tests/wsl-notify.zsh"
  }
}

hooks {
  ["pre-commit"] {
    steps = checks
  }
  ["check"] {
    steps = checks
  }
}
