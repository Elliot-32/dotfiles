amends "package://github.com/jdx/hk/releases/download/v1.57.0/hk@1.57.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v1.57.0/hk@1.57.0#/Builtins.pkl"

local checks = new Mapping<String, Step> {
  ["shellcheck"] = (Builtins.shellcheck) {
    check = "shellcheck -x {{files}}"
  }
  ["sh-syntax"] {
    glob = List("scripts/*.sh")
    check = "sh -n {{files}}"
    batch = true
  }
  ["zsh-syntax"] {
    glob = List(".zshrc", ".p10k.zsh")
    check = "zsh -n {{files}}"
    batch = true
  }
}

hooks {
  ["pre-commit"] {
    steps = checks
  }
  ["check"] {
    steps = checks
  }
}
